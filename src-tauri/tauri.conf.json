{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HideMyWindows",
  "version": "2.0.5",
  "identifier": "io.github.zcri.hidemywindows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HideMyWindows",
        "width": 1000,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": ["resources/hmw_payload.dll"],
    "publisher": "Mehdi",
    "copyright": "MIT with Commons Clause. Original © Cristian Gambino (@zCri).",
    "shortDescription": "Hide your windows from screen capture.",
    "longDescription": "HideMyWindows hides any window on your PC from screenshots, screen recordings and streaming software like OBS.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "French", "Italian", "Romanian", "Polish"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NzE1MjJCQkM2OUFCNEYKUldSUHEybThLMUp4ZDU1Ymtab1VEV3NVSWVOdDlaWFM0ZkNnbDhkd2M5RWVkeHAwb2QvTlFIbU8K",
      "endpoints": [
        "https://github.com/mehdimamas/hidemywindows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
